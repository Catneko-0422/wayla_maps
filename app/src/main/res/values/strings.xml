<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name" translatable="false">Wayla Maps</string>

    <!-- Spoken prompts: keep them short, one fact per sentence.
         Distances are rounded to 50 m and never below 50, so "meters" is always plural. -->
    <string name="alert_speed_camera_with_limit" tools:ignore="PluralsCandidate">Speed camera in %1$d meters, limit %2$d</string>
    <string name="alert_speed_camera" tools:ignore="PluralsCandidate">Speed camera in %1$d meters</string>

    <string name="notification_channel_alerts">Speed camera alerts</string>
    <string name="notification_alerts_running">Speed camera alerts are on</string>
    <string name="action_stop">Stop</string>
</resources>
